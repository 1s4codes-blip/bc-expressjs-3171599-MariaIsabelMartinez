// Prisma Schema — Proyecto Semana 05
// Dominio: Empresa de importación (Shipments + CustomsBrokers)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// CustomsBroker — Agente aduanal (recurso secundario)
// Un broker gestiona múltiples embarques (relación 1:N)
// ============================================================

model CustomsBroker {
  id            Int       @id @default(autoincrement())
  companyName   String
  licenseNumber String    @unique
  contactEmail  String    @unique
  phone         String?
  country       String
  active        Boolean   @default(true)
  shipments     Shipment[] // Campo virtual — no genera columna en BD
  createdAt     DateTime  @default(now())
}

// ============================================================
// Shipment — Embarque internacional (recurso principal)
// Mínimo 8 campos tipados, @unique en trackingNumber
// ============================================================

model Shipment {
  id              Int      @id @default(autoincrement())
  trackingNumber  String   @unique
  origin          String
  destination     String
  status          String   @default("PENDING") // PENDING, IN_TRANSIT, CUSTOMS, CLEARED, DELIVERED
  weight          Float
  containerCount  Int      @default(1)
  departureDate   DateTime
  arrivalDate     DateTime?
  customsBrokerId Int?     // FK opcional hacia CustomsBroker
  broker          CustomsBroker? @relation(fields: [customsBrokerId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
